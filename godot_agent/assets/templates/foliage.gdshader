// godot-agent foliage v1
// Alpha-cut foliage cards (pine boughs, leaf clumps, grass, ferns) from
// `godot-agent asset texture <card> --material`. The card texture is painted in grey
// values; the model's vertex colour tints it, so one card serves green, amber and red
// trees. Cards sway in the wind, more the higher they sit on the model, so trunks stay
// put. Regenerated by godot-agent when this header changes; edit a copy to customise.
shader_type spatial;
render_mode cull_disabled, depth_draw_opaque;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_disable;
uniform float alpha_cut : hint_range(0.0, 1.0) = 0.42;
uniform float tint_boost = 1.45;
uniform float wind_strength = 0.035;
uniform float wind_speed = 1.4;
uniform float top_light : hint_range(0.0, 0.6) = 0.25;

void vertex() {
	vec3 origin = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	float phase = origin.x * 0.7 + origin.z * 0.9;
	float sway = max(VERTEX.y, 0.0) * wind_strength;
	VERTEX.x += sin(TIME * wind_speed + phase + VERTEX.y * 1.7) * sway;
	VERTEX.z += cos(TIME * wind_speed * 0.8 + phase * 1.3) * sway * 0.6;
}

void fragment() {
	vec4 tex = texture(albedo_tex, UV);
	vec3 col = tex.rgb * COLOR.rgb * tint_boost;
	vec3 world_normal = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	col *= 1.0 + top_light * abs(world_normal.y);
	ALBEDO = clamp(col, 0.0, 1.0);
	ALPHA = tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_cut;
	ROUGHNESS = 0.85;
}
