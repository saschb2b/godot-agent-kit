// godot-agent painted v3
// Hand-painted surfaces for models from `godot-agent asset mesh`.
//
// Vertex color carries the paint (linear RGB) and, in alpha, which pattern to draw:
// 0 plain, 1 bricks, 2 planks, 3 shingles, 4 metal, 5 cobble, 6 cloth, 7 gold,
// 8 crystal, 9 bark, 10 leaves, 11 thatch, 12 stone. UV is in metres of the part.
// Patterns are painted the way strategy-game textures are: each brick, plank or
// shingle gets its own tint, a lit upper edge and a shadowed lower edge, dark
// grout between, and the whole surface is lifted toward the light from above.
// Regenerated by godot-agent when this header changes; edit a copy to customise.
shader_type spatial;

uniform float pattern_strength : hint_range(0.0, 1.0) = 1.0;
uniform float top_light : hint_range(0.0, 0.6) = 0.22;
uniform float ambient_lift : hint_range(0.0, 0.5) = 0.1;
uniform float rim_light : hint_range(0.0, 1.0) = 0.25;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(
		mix(hash12(i), hash12(i + vec2(1.0, 0.0)), u.x),
		mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), u.x), u.y);
}

float fbm(vec2 p) {
	return 0.55 * vnoise(p) + 0.3 * vnoise(p * 2.1 + 5.2) + 0.15 * vnoise(p * 4.3 + 1.7);
}

// x: distance to the nearest cell border (0 on the border), y: cell id in [0, 1).
vec2 voronoi(vec2 p) {
	vec2 n = floor(p);
	vec2 f = fract(p);
	float d1 = 8.0;
	float d2 = 8.0;
	float id = 0.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 g = vec2(float(i), float(j));
			vec2 o = vec2(hash12(n + g), hash12(n + g + 17.3)) * 0.8 + 0.1;
			float d = length(g + o - f);
			if (d < d1) {
				d2 = d1;
				d1 = d;
				id = hash12(n + g + 3.1);
			} else if (d < d2) {
				d2 = d;
			}
		}
	}
	return vec2(d2 - d1, id);
}

vec3 tint(vec3 c, float h) {
	// Value and a touch of warmth vary per brick/plank, as a painter would.
	return c * (0.8 + 0.36 * h) * vec3(1.0 + 0.06 * (h - 0.5), 1.0, 1.0 - 0.06 * (h - 0.5));
}

vec3 bricks(vec3 c, vec2 uv) {
	vec2 size = vec2(0.2, 0.1);
	vec2 p = uv / size;
	float row = floor(p.y);
	p.x += mod(row, 2.0) * 0.5;
	vec2 cell = floor(p);
	vec2 f = fract(p);
	float h = hash12(cell);
	float n = fbm(uv * 30.0);
	vec2 e = min(f, 1.0 - f) * size;
	float edge = min(e.x, e.y);
	float grout = 1.0 - smoothstep(0.005, 0.011 + 0.008 * n, edge);
	vec3 brick = tint(c, h) * (0.88 + 0.24 * n);
	brick *= 1.0 + 0.22 * smoothstep(0.72, 0.98, f.y) - 0.2 * smoothstep(0.3, 0.0, f.y);
	brick *= 1.0 - 0.25 * step(0.86, vnoise(uv * 55.0 + h * 9.0)); // chips
	return mix(brick, c * 0.38, grout);
}

vec3 stone_blocks(vec3 c, vec2 uv) {
	// Large dressed stones of uneven width, for foundations and plinths.
	vec2 size = vec2(0.32, 0.16);
	vec2 p = uv / size;
	float row = floor(p.y);
	p.x += hash12(vec2(row, 7.0)) * 0.9;
	vec2 cell = floor(p);
	vec2 f = fract(p);
	float h = hash12(cell + 0.5);
	float n = fbm(uv * 18.0);
	vec2 e = min(f, 1.0 - f) * size;
	float edge = min(e.x, e.y);
	float grout = 1.0 - smoothstep(0.006, 0.016 + 0.01 * n, edge);
	vec3 stone = tint(c, h) * (0.85 + 0.3 * n);
	stone *= 1.0 + 0.18 * smoothstep(0.7, 1.0, f.y) - 0.15 * smoothstep(0.35, 0.0, f.y);
	return mix(stone, c * 0.35, grout);
}

vec3 planks(vec3 c, vec2 uv) {
	float w = 0.11;
	float column = floor(uv.x / w);
	float f = fract(uv.x / w);
	float h = hash12(vec2(column, 3.0));
	float gap = 1.0 - smoothstep(0.035, 0.09, min(f, 1.0 - f));
	float grain = vnoise(vec2(uv.x * 70.0, uv.y * 5.0 + h * 13.0));
	float knot = smoothstep(0.08, 0.0, length(vec2(f - 0.5, fract(uv.y * 1.3 + h) - 0.5) * vec2(1.0, 3.0)));
	vec3 wood = tint(c, h) * (0.8 + 0.3 * grain);
	wood *= 1.0 + 0.16 * (1.0 - abs(f - 0.5) * 2.0);
	wood = mix(wood, c * 0.45, knot * 0.6);
	return mix(wood, c * 0.3, gap);
}

vec3 shingles(vec3 c, vec2 uv) {
	vec2 size = vec2(0.13, 0.09);
	vec2 p = uv / size;
	float row = floor(p.y);
	p.x += mod(row, 2.0) * 0.5;
	vec2 cell = floor(p);
	vec2 f = fract(p);
	float h = hash12(cell);
	float curve = 0.28 * (1.0 - sin(3.14159 * f.x));
	float lip = smoothstep(curve + 0.12, curve, f.y);
	vec3 tile = tint(c, h) * mix(0.72, 1.12, smoothstep(1.0, curve + 0.05, f.y));
	tile *= 1.0 + 0.25 * lip;
	vec3 shadow = c * 0.42;
	tile = mix(shadow, tile, smoothstep(curve - 0.03, curve + 0.02, f.y));
	float seam = 1.0 - smoothstep(0.0, 0.05, min(f.x, 1.0 - f.x));
	return mix(tile, c * 0.45, seam * step(curve, f.y) * 0.7);
}

vec3 cobble(vec3 c, vec2 uv) {
	vec2 v = voronoi(uv / 0.09);
	float grout = 1.0 - smoothstep(0.05, 0.14, v.x);
	vec3 stone = tint(c, v.y) * (0.88 + 0.24 * fbm(uv * 25.0));
	stone *= 0.9 + 0.3 * smoothstep(0.1, 0.5, v.x);
	return mix(stone, c * 0.35, grout);
}

vec3 leaves(vec3 c, vec2 uv) {
	// Soft clumps: each one brighter where it bulges toward the light, with no
	// outline between them, and fine leaf noise on top.
	vec2 v = voronoi(uv / 0.05);
	float dome = smoothstep(0.0, 0.4, v.x);
	vec3 clump = tint(c, v.y) * (0.84 + 0.3 * dome);
	return clump * (0.88 + 0.22 * vnoise(uv * 85.0 + v.y * 7.0));
}

void fragment() {
	vec3 c = COLOR.rgb;
	int pattern = int(floor(COLOR.a * 16.0));
	vec2 uv = UV;
	vec3 albedo = c * (0.94 + 0.12 * vnoise(uv * 12.0));
	float roughness = 0.9;
	float metallic = 0.0;
	vec3 emission = vec3(0.0);
	if (pattern == 1) {
		albedo = bricks(c, uv);
	} else if (pattern == 2) {
		albedo = planks(c, uv);
	} else if (pattern == 3) {
		albedo = shingles(c, uv);
	} else if (pattern == 4) {
		albedo = c * (0.82 + 0.3 * vnoise(uv * vec2(40.0, 5.0)));
		metallic = 0.55;
		roughness = 0.38;
	} else if (pattern == 5) {
		albedo = cobble(c, uv);
	} else if (pattern == 6) {
		float weave = sin(uv.x * 420.0) * sin(uv.y * 420.0);
		float folds = sin(uv.x * 22.0 + fbm(uv * 4.0) * 4.0);
		albedo = c * (0.95 + 0.05 * weave) * (0.86 + 0.16 * folds);
	} else if (pattern == 7) {
		albedo = c * (0.78 + 0.45 * fbm(uv * 14.0));
		metallic = 0.75;
		roughness = 0.3;
	} else if (pattern == 8) {
		vec2 v = voronoi(uv / 0.07);
		albedo = c * (0.75 + 0.55 * v.y);
		emission = c * 0.35;
		roughness = 0.15;
	} else if (pattern == 9) {
		float streak = vnoise(vec2(uv.x * 28.0, uv.y * 3.0));
		float crack = smoothstep(0.78, 0.86, vnoise(vec2(uv.x * 34.0, uv.y * 2.0) + 4.0));
		albedo = c * (0.75 + 0.4 * streak) * (1.0 - 0.45 * crack);
	} else if (pattern == 10) {
		albedo = leaves(c, uv);
	} else if (pattern == 11) {
		albedo = c * (0.72 + 0.5 * vnoise(vec2(uv.x * 90.0, uv.y * 6.0)));
	} else if (pattern == 12) {
		albedo = stone_blocks(c, uv);
	}
	albedo = mix(c, albedo, pattern_strength);

	// Painted light: tops catch the sky, silhouettes get a soft rim, shadows stay readable.
	vec3 world_normal = normalize((INV_VIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
	albedo *= 1.0 + top_light * world_normal.y;
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	ALBEDO = clamp(albedo, 0.0, 1.0);
	ROUGHNESS = roughness;
	METALLIC = metallic;
	EMISSION = emission + albedo * (ambient_lift + rim_light * rim * 0.4);
}
