{
  "name": "ticks_per_frame",
  "description": "The kit hands ticks_per_frame to the game before its scene loads, and set_ticks_per_frame changes it mid-run.",
  "scene": "res://ticks.tscn",
  "ticks_per_frame": 8,
  "watch": {"tick": "scene.sim.tick", "hash": "scene.sim.state_hash()"},
  "steps": [
    {"assert": "scene.at_ready == 8", "msg": "the hook is set before the scene's _ready"},
    {"eval": "scene.sim.tick", "as": "t0"},
    {"wait": 10},
    {"assert": "scene.sim.tick - t0 == 80", "msg": "8 ticks per frame for 10 frames"},
    {"set_ticks_per_frame": 2},
    {"eval": "scene.sim.tick", "as": "t1"},
    {"wait": 10},
    {"assert": "scene.sim.tick - t1 == 20", "msg": "2 ticks per frame after set_ticks_per_frame"},
    {"set_ticks_per_frame": 0},
    {"eval": "scene.sim.tick", "as": "t2"},
    {"wait": 5},
    {"assert": "scene.sim.tick == t2", "msg": "0 holds the simulation"}
  ]
}
